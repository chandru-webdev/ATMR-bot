# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- MT5 account (demo first, always) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password
MT5_SERVER=YourBroker-Demo

# --- Trading mode guard (see SECURITY.md section 2) ---
TRADING_MODE=demo
# Required ONLY when TRADING_MODE=live:
CONFIRM_LIVE=
LIVE_SERVER=

# --- n8n (see ARCHITECTURE.md section 6) ---
N8N_BASE_URL=https://your-n8n-host/webhook
X_BOT_API_KEY=generate_a_long_random_string_here

# --- Telegram (direct fallback alerts, see SECURITY.md) ---
TELEGRAM_BOT_TOKEN=123456:your_botfather_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Email (optional, trade log details) ---
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# --- Twilio (optional, deferred per PRD) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
